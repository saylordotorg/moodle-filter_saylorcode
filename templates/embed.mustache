{{!
    @template filter_saylorcode/embed

    A coding exercise embedded in a Page, Book chapter or Lesson page.

    The markup degrades rather than breaking. Without JavaScript the reader
    still gets a described link to the stand alone exercise, which is why the
    fallback link is present in the server rendered output rather than being
    injected later.

    Classes required for JS:
    * saylorcode-embed

    Data attributes required for JS:
    * data-region="saylorcode-embed"
    * data-exercise
    * data-version

    Context variables required for this template:
    * exercise string Stable exercise id, for example CS101-U05-E03.
    * mode string compact or full.
    * version string latest, or a version number.
    * pinned bool Whether an explicit version is pinned.
    * height int|null Requested height in pixels, already validated.
    * showinstructions bool Whether the instructions pane is shown.
    * allowfullscreen bool Whether a full screen control is offered.
    * canpersist bool Whether the viewer is signed in and work can be saved.
    * uniqid string Unique DOM id for this occurrence.
    * activityurl string Link to the stand alone exercise.

    Example context (json):
    {
        "exercise": "CS101-U05-E03",
        "mode": "compact",
        "version": "latest",
        "pinned": false,
        "height": 500,
        "showinstructions": true,
        "allowfullscreen": true,
        "canpersist": true,
        "uniqid": "saylorcode_embed_abc123",
        "activityurl": "https://example.org/local/saylorcode/exercise.php?stableid=CS101-U05-E03"
    }
}}
<div class="saylorcode-embed saylorcode-embed-{{mode}}"
     id="{{uniqid}}"
     data-region="saylorcode-embed"
     data-exercise="{{exercise}}"
     data-version="{{version}}"
     {{#height}}style="min-height: {{height}}px;"{{/height}}>

    {{^canpersist}}
        <div class="alert alert-info" role="status">
            {{#str}}notsignedin, filter_saylorcode{{/str}}
            <a href="{{activityurl}}">{{#str}}openexercise, filter_saylorcode{{/str}}</a>
        </div>
    {{/canpersist}}

    {{#canpersist}}
        {{! Server rendered fallback. Replaced once the workspace module loads,
            so a reader without JavaScript is never left with an empty box. }}
        <noscript>
            <div class="alert alert-info">
                {{#str}}nojavascript, filter_saylorcode{{/str}}
                <a href="{{activityurl}}">{{#str}}openexercise, filter_saylorcode{{/str}}</a>
            </div>
        </noscript>

        <div class="saylorcode-embed-body" data-region="embed-body">
            <div class="saylorcode-embed-loading" data-region="loading">
                {{#str}}loadingexercise, filter_saylorcode{{/str}}
            </div>
        </div>

        <div class="saylorcode-embed-footer">
            <a href="{{activityurl}}" class="saylorcode-embed-open">
                {{#allowfullscreen}}{{#str}}openfullscreen, filter_saylorcode{{/str}}{{/allowfullscreen}}
                {{^allowfullscreen}}{{#str}}openexercise, filter_saylorcode{{/str}}{{/allowfullscreen}}
            </a>
        </div>
    {{/canpersist}}
</div>
